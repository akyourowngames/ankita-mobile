{
  "name": "chief-mobile",
  "version": "2.1.1",
  "type": "module",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "serve:web": "node scripts/serve-web.mjs",
    "build:bundles": "expo export --platform all --output-dir release/bundles",
    "verify:ui": "node scripts/verify-mobile.mjs",
    "verify:dev": "node scripts/verify-dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "verify:assistant": "node scripts/verify-assistant.mjs",
    "desktop:companion": "node scripts/desktop-companion.mjs",
    "work:server": "node scripts/work-server.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo-google-fonts/sora": "0.4.2",
    "@expo/metro-runtime": "57.0.16",
    "@expo/vector-icons": "15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "57.0.25",
    "expo-asset": "57.0.18",
    "expo-blur": "57.0.3",
    "expo-build-properties": "57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "57.0.2",
    "expo-document-picker": "57.0.3",
