<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds also trust the phone owner's CA store so a development build can pair with a desktop on the LAN. Release builds keep the system store only and never disable certificate validation. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>
